[sub_resource type="ButtonGroup" id="ButtonGroup_modes"]

[node name="TopBar" type="PanelContainer"]
anchors_preset = 10
anchor_right = 1.0
offset_bottom = 40.0
grow_horizontal = 2
script = ExtResource("1_topbar")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 2
theme_override_constants/margin_left = 12
theme_override_constants/margin_top = 3
theme_override_constants/margin_right = 12
theme_override_constants/margin_bottom = 3

[node name="Row" type="HBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="SystemMenu" type="MenuButton" parent="Margin/Row"]
unique_name_in_owner = true
custom_minimum_size = Vector2(40, 32)
layout_mode = 2
size_flags_horizontal = 0
theme_override_constants/icon_max_width = 23
tooltip_text = "Меню"
action_mode = 1
icon = ExtResource("3_menu")

[node name="LayoutNameLabel" type="Label" parent="Margin/Row"]
unique_name_in_owner = true
custom_minimum_size = Vector2(160, 0)
layout_mode = 2
mouse_filter = 0
tooltip_text = "Двойной щелчок: переименовать"
text = "Новый макет"
vertical_alignment = 1
clip_text = true
text_overrun_behavior = 3

[node name="LayoutNameEdit" type="LineEdit" parent="Margin/Row"]
unique_name_in_owner = true
visible = false
custom_minimum_size = Vector2(160, 32)
layout_mode = 2
max_length = 64

[node name="LabLabel" type="Label" parent="Margin/Row"]
unique_name_in_owner = true
visible = false
layout_mode = 2
theme_type_variation = &"LabelDim"
text = "[LAB]"
vertical_alignment = 1

[node name="StatsHost" type="Control" parent="Margin/Row"]
unique_name_in_owner = true
clip_contents = true
layout_mode = 2
size_flags_horizontal = 3

[node name="StatsBar" type="HBoxContainer" parent="Margin/Row/StatsHost"]
unique_name_in_owner = true
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/separation = 16

[node name="MoreStats" type="MenuButton" parent="Margin/Row/StatsHost/StatsBar"]
unique_name_in_owner = true
visible = false
custom_minimum_size = Vector2(36, 32)
layout_mode = 2
size_flags_vertical = 4
tooltip_text = "Остальная статистика"
text = "…"

[node name="ModePanel" type="MarginContainer" parent="Margin/Row"]
unique_name_in_owner = true
layout_mode = 2
mouse_filter = 0
