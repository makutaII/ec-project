[resource]
script = ExtResource("2_es")
key = &"decor.portal.tunnel_portal"
name = "Портал тоннеля"
description = "Арка входа в гору (бетон или камень), глубина 1-5 ю, тёмный проём. Рельеф не меняет: рельсы с флагом U, портал задвигается в гору, R/F уровень, G стиль"
category = &"decor"
tag = &"portal"
icon = ExtResource("8_ic")
sort_order = 10
build_behavior = 1
pick_layers = Array[StringName]([&"ground", &"tracks", &"plaster"])
components = Array[ExtResource("1_cs")]([SubResource("Resource_id"), SubResource("Resource_tp"), SubResource("Resource_dr"), SubResource("Resource_ho"), SubResource("Resource_se")])
