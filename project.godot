; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[ResCleaner]

data/ignore_folder=["ui"]
data/keep_list=Array[String]([])
data/use_multithreading=false

[application]

config/name="EC_project"
config/version="0.6.0"
config/tags=PackedStringArray("actual")
run/main_scene="uid://csy3eqxdwo2lo"
config/features=PackedStringArray("4.8", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Global="*uid://cuyqabojk5lbh"
Settings="*res://core/settings.gd"
Actions="*res://core/input_actions.gd"
GFX="*uid://ibw0xeowgtvh"
PGM="*uid://cs6t1pamqjrbq"
Outline="*uid://bsgvq8tlldjvo"
Hints="*res://core/controllers/hint_manager.gd"
TGM="*res://core/controllers/terrain_manager.gd"
LYM="*res://core/controllers/layout_manager.gd"
TSM="*res://core/controllers/track_style_manager.gd"
SND="*res://core/controllers/sound_manager.gd"
InfoTips="*res://core/controllers/info_tips.gd"

[debug]

file_logging/enable_file_logging=true

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1600
window/size/window_height_override=900

[editor_plugins]

enabled=PackedStringArray("res://addons/Todo_Manager/plugin.cfg", "res://addons/fancy_folder_colors/plugin.cfg", "res://addons/godotresourcecleaner/plugin.cfg", "res://addons/kanban_tasks/plugin.cfg")

[file_customization]

folder_colors={
"res://core/": "blue"
}

[filesystem]

import/blender/enabled=false

[gui]

theme/custom="uid://t2vamkehlekl"

