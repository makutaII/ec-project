[layer_names]

3d_render/layer_1="ground"
3d_render/layer_3="tracks"
3d_render/layer_10="ghost"
3d_render/layer_11="selected"
3d_physics/layer_1="ground"
3d_physics/layer_3="tracks"
3d_physics/layer_4="sockets"
3d_physics/layer_5="trains"
3d_physics/layer_7="flex_handle"
3d_physics/layer_8="room"
3d_physics/layer_9="supports"
