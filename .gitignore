# Godot 4+ specific ignores
.godot/
/android/
/addons/
*.tmp
*.patch
*.bat
*.kanban
# Blender: резервные копии
*.blend1
*.blend@

*.wav
*.mp3
*.ogg

# Python (tools/)
__pycache__/
*.pyc

# Звук (ATTN_26, S0.6): ленты, нарезка и спектрограммы не коммитятся, в git только листы меток
data/sounds/*/*
!data/sounds/*/*.sheet.json
data/sounds/*/*.draft.sheet.json
