class_name FieldSurface extends Resource

# XX claude-terra 13.14 H2b (новый файл)
###################################
## Поверхность кисти рельефа (ATTN_13 §13.14, H2b): текстура, оттенок, размер повтора и класс рельефа. Лежит в карточке кисти
## (TerrainBrush.surfaces). Кисть с одной поверхностью красит ею, с несколькими красит пятнами по весам (weight).
## Текстуры мировые (по XZ, на крутых склонах боковая проекция), нормали и ORM не используются.
## Слот в палитре (до 16 материалов на игру) выдаёт FieldMaterials по текстуре, оттенку и повтору: одинаковые поверхности делят слот.
###################################

## Текстура цвета (sRGB). null: поверхность рисуется однотонно цветом tint
@export var texture: Texture2D
## Оттенок, множится на текстуру
@export var tint := Color.WHITE
## Размер одного повтора текстуры, ю
@export var tile := 3.0
## Класс рельефа узла (шум высоты): гладкая без шума, каменистая небольшой шум, скалистая крупный. Это не материал, а форма поверхности
@export_enum("гладкая", "каменистая", "скалистая") var kind := 0
## Вес в смеси кисти (у кисти с одной поверхностью не важен)
@export var weight := 1.0
## Подпись кисти с одной этой поверхностью. Пусто: название класса рельефа
@export var label := ""


## Ключ материала: поверхности с одной текстурой, оттенком и повтором делят слот палитры (класс рельефа в слот не входит)
func material_key() -> String:
	var tp := texture.resource_path if texture != null else ""
	return "%s|%s|%.3f" % [tp, tint.to_html(true), tile]
