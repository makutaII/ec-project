class_name TerrainBrush extends ComponentSettings

# XX claude-terra 13.14 H2 (новый файл)
###################################
## Кисть рельефа (ATTN_13 §13.14): описание кисти в карточке каталога. Не компонент объекта: карточка кисти это инструмент (BRUSH_TOOL),
## её ставит ToolController. Новая кисть = копия .tres карточки с другими значениями, код не нужен.
###################################
## Модель кисти «площадка + склон» (спайк H0, tests/field_spike): площадка радиуса p держит высоту, склон шириной w идёт под углом angle_deg
## до края. Склон не уже одной ячейки (угол 90° это склон в ячейку) и не шире, чем помещается (иначе угол смягчается).

## Веса типов поверхности: x гладкая, y каменистая, z скалистая. Веса (1, 0, 0) чистая гладкая, смесь даёт пёстрый рельеф
## (тип узла выбирается по хешу узла, поэтому мазок по тому же месту не мигает)
@export var surface_mix := Vector3(1.0, 0.0, 0.0)
## Угол склона от горизонтали, градусы. Игрок меняет `[` `]`
@export_range(5.0, 90.0, 1.0) var angle_deg := 25.0
## Радиус кисти по умолчанию и пределы, ю. Игрок меняет Alt+колесо или `,` `.`
@export var radius_default := 5.0
@export var radius_min := 1.5
@export var radius_max := 15.0
## Минимальный радиус площадки, ю
@export var plateau_min := 1.0
## Допуск: на какую долю радиуса склон может выйти за радиус (и не больше tolerance_max, ю), чтобы вместить угол
@export var tolerance_frac := 0.25
@export var tolerance_max := 3.0
## Сила ЛКМ-выравнивания 0,1..1: скорость подтягивания к высоте якоря
@export_range(0.1, 1.0, 0.1) var strength := 0.5
## Высота площадки на один щелчок Ctrl+колеса, слоёв (с Shift до целого слоя)
@export var notch_layers := 0.25
## Наибольшая толщина слоя шпатлёвки над полом, слоёв (поле хранит до 31,99)
@export var max_layers := 16.0
## Объекты в зоне кисти (H3): 0 игнорировать (кисть идёт под объектом, объект может утонуть), 1 обходить (узлы под объектом
## не меняются), 2 поднимать вместе с рельефом (объект садится на новую высоту). Игрок переключает клавишей X
@export_enum("игнорировать", "обходить", "поднимать") var objects_mode := 1


## Карточка кисти не создаёт компонент: кисть живёт в инструменте
func create_component(_entity: Entity) -> Component:
	return null
