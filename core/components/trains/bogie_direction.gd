@tool
class_name BogieDirection extends RefCounted

###########################
## Направление «положительной» скорости тележки на траке без питания (ATTN_27, шаг C2)
###########################
## На траках с C_PowerTrack знак движения даёт полярность питания (flip_of). У траков без питания
## (горки) полярности нет, поэтому знак хранит сама тележка (BogieData.dir_sign) и на стыке трасс
## выбирается так, чтобы мировое направление движения продолжилось. Чистая математика, без нод.


## Знак (+1 или −1) для нового трака.
## pos_dir: мировое направление движения при положительной скорости в конце старого трака (единичный вектор).
## new_fwd: мировая касательная нового сплайна (в сторону роста длины) у точки входа.
## fallback: прежний знак, если векторы почти перпендикулярны и однозначно не решить.
static func inherit(pos_dir: Vector3, new_fwd: Vector3, fallback: float) -> float:
	var d := pos_dir.dot(new_fwd)
	if absf(d) < 0.001:
		return fallback
	return 1.0 if d > 0.0 else -1.0
