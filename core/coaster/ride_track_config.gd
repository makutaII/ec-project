class_name RideTrackConfig extends TrackConfig

###########################
## Паспорт трака горок (ATTN_27 §27.4)
###########################
## Подкласс TrackConfig: всё, что читают обычные траки (height, collision_width, allow_underground),
## работает как есть. Форма задаётся не radius/rise, а полями ниже; поле deg (унаследованное) это поворот в плане,
## + вправо. radius и rise не используются: C_RidePath считает их сам по форме.
## Форма строится RideShape; вертикальный радиус дуги получается из длины и разницы углов: R = length / Δугол.
## Примеры: прямой уклон 15° (start = end = 15), въезд на подъём (0 → 15), выезд (15 → 0), спуск (0 → −15).

## Длина вдоль оси трака (по самой кривой, не по горизонтали), ю
@export var length := 10.0
## Угол касательной над горизонтом в начале трака, градусы (+ вверх по ходу от начала к концу кривой)
@export var pitch_start_deg := 0.0
## Угол касательной над горизонтом в конце трака, градусы
@export var pitch_end_deg := 0.0


## StyleVisualSetting спрашивает у паспорта, каким компонентом строить путь
func create_path() -> C_Path:
	return C_RidePath.new()
