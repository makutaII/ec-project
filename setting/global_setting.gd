class_name GlobalSetting extends Resource

##########################
## Настройки объектов
###########################
## Подключаются в синглтоне Global


######### TRACK ##############
@export_group("Tracks")
@export var track_head_segment  = {
	'align_ends' : false, # Выравнивание торцов
	'deg_per_segment' : 10.0, # сколько градусов закрывает один сегмент
	'gap' : 0.0, # зазор между сегментами.
	"size" : Vector2(0.2, 0.25), # (1.65 + 0,1 +0,1) = 1.85 или 0.2, если 2шт
	'start_end_padding' : -0.2,	 #  минус - внутрь трака, плюс =0 
	'offset_x' : 0.875, # 0, или 0.875-смещение влево относительно центра 0.1 -по z, если 2шт
	'static_generation_ballast' : true, # Метод генерации статикбоди трака
	'static_generation_heads' : 2,
	}

@export var track_ballast_segment = {
	'align_ends' : false, # Выравнивание торцов
	'deg_per_segment' : 10.0,
	"gap" : 0.0,
	"size" : Vector2(3.2, 0.6),
	'start_end_padding' : -0.2,	 #  минус - внутрь трака, плюс =0 
	'offset_x' : 0.0, #смещение влево 
}

# XX claude-terra
@export_group("Terrain")
## T - высота одного слоя (уровня) рельефа и трака, ю. 1.0 = 1 см модели
@export var layer_height := 1.0
## Шаг опор эстакады вдоль трака, ю
@export var support_step := 8.0
## Если зазор между низом балласта и землей меньше - опоры не нужны, ю
@export var support_min_clearance := 0.4
## Допустимый излом стыка по вертикали, градусы (суммарный уклон двух сторон стыка).
## 4.0: «горб» двух пандусов rise = 1.0 (по 2,4°) отклоняется, два пологих (по 1,2°) проходят
@export var joint_kink_max_deg := 6.0
## XX claude-coaster C5.4: допустимая разница крена на стыке, градусы (вращение сечения вокруг оси стыка).
## У траков без крена она 0, поэтому на обычные траки это не влияет. Меньше: стык «ступенькой» крена виден на лотке
@export var joint_bank_max_deg := 3.0
## XX claude-coaster C6.0: переход тележки на соседний трак. Дальше этого от конца соседа въезд закрыт (трак поперёк, Т-стык), ю.
## Такой же допуск 1.0 у въезда на стрелку (C_Path.entry_route)
@export var joint_transition_gap_max := 1.0
## Допустимый угол между направлением хода и касательной соседа у его конца, градусы (стык с изломом до 6° проходит с запасом).
## Трак поперёк (90°) не принимается: тележка не поворачивает на него, а сходит с конца и упирается
@export var joint_transition_max_deg := 30.0
## Допуск по высоте между сокетами стыка (поверхность катания), ю. Больше: трактуем как ступеньку между стилями
## (разная head_height), электрической связи нет (нужен переходный элемент, ATTN_15 §2.10)
@export var joint_level_tol := 0.05
## Радиус вертикального магнита к чужому сокету (по горизонтали), ю
@export var magnet_radius := 3.0
## Максимальная разница высот, при которой магнит еще срабатывает, ю
@export var magnet_max_dy := 6.0
# XX claude-terra
## Насколько трак может уходить под землю при снапе/магните, ю (больше - снап отклоняется)
@export var underground_tolerance := 0.1
# XX claude-terra
## Шаг сетки привязки листов пенопласта по XZ, ю
@export var terrain_grid_step := 1.0
# XX claude-terra
## Вертикальный магнит листа к плоскому траку: если верх листа ближе этой высоты к низу балласта, лист прилипает вплотную, ю
## (меньше layer_height, чтобы лист не перескакивал через целый уровень)
@export var terrain_snap_dy := 0.6
# XX claude-terra 13.2
## Магнит листа к траку, который ВЫШЕ верха листа: на сколько слоёв лист подтягивается вверх, чтобы встать вплотную под
## низ балласта. Нужен, потому что трак и лист стоят по уровням (кратно layer_height), и dy 0,6 до трака на ступень выше
## никогда не достаёт. 0 = выключено. Alt при перетаскивании листа отключает магнит
@export var terrain_snap_levels := 4
# XX claude-terra 13.2 B8
## Зазор автовыреза под траком (канава и тоннель): на сколько вырез шире балласта с каждой стороны и на концах трака, ю.
## 0 = вплотную к балласту. Пересчёт идёт при следующей перестройке листа или смене трака
@export var terrain_cut_margin := 0.5
# XX claude-terra 13.2 B6
## Автонасыпь (клавиша B на выбранном траке): плечо насыпи с каждой стороны балласта, ю
@export var embankment_shoulder := 1.0
# XX claude-terra 13.14 H5
## Автоложе трака на поле высот (шпатлёвке): выемка под траком в холме и насыпь над низиной. Ложе считается поверх поля, поле не меняется
@export var field_bed_enabled := true
## Откос ложа: ю в плане на 1 ю высоты (1,5 это около 34°)
@export var field_bed_run := 1.5
# XX claude-terra 13.14 H5c
## Откос бортов в режиме ложа «Только полоса» по умолчанию, ю в плане на 1 ю высоты (меньше: круче; 0,05 почти вертикально).
## У каждого трака можно задать свой в InfoPanel (вкладка «Вид»)
@export var field_bed_strip_run := 0.05
## Насыпь не выше этого над землёй, слоёв (выше эстакада на опорах, поле под ней не трогается)
@export var field_bed_fill_max := 3.0
# XX claude-terra 13.5
## Гипсовый бинт: наибольший подъём оболочки над ступенью, слоёв. Выше слоя обрыв остаётся обрывом (у подошвы слой пандуса)
@export var plaster_max_up := 1.0
## Гипсовый бинт: на сколько ю от балласта плюс зазор (terrain_cut_margin) оболочка не поднимается над ступенью под траком
@export var plaster_pin_margin := 1.0
# XX claude-terra 13.13 K0
## Гипсовый бинт: писать в Output время каждой пересборки оболочки по фазам (замер перед кистями). Включать на время замера
@export var plaster_log_time := false
# XX claude-terra 13.13 K3b
## Гипсовый бинт: какую долю первого шага пандуса убрать у края ступени (0..1). Без этого оболочка у верха стенки листа на шаг
## ниже среза, и срез торчит над гипсом бортиком. 0 = как было, 0,8 = бортик почти ушёл, 1 = вровень (возможна рябь на стыке)
@export_range(0.0, 1.0, 0.05) var plaster_lip := 0.8
# XX claude-terra 13.13 K3c
## Гипсовый бинт: красить стенки листа с бинтом от краски на краю верха (полоса идёт вниз по стенке). Срез (канавы, тоннели) не красится.
## Влияет при следующей сборке листа или смене бинта
@export var plaster_paint_walls := true
# XX claude-terra 13.13 K4
## Гипсовый бинт: масштаб мелкого рельефа крашеных ячеек (бугры скалы, россыпь гравия, волны травы). 0 = выключено, 1 = как задумано
@export var plaster_relief_scale := 1.0
# XX claude-terra
## Габарит тоннеля: свободная высота над головкой рельса, ю. Лист над тоннельным траком прорезается на эту высоту
## (выше остается свод). Подбирать по высоте самого высокого вагона
@export var tunnel_clearance := 5.0

# XX claude-terra
@export_group("Flex")
## Минимальный радиус flex (= min_curve_radius вагонов), ю
@export var flex_r_min := 15.0
@export var flex_l_min := 5.0
@export var flex_l_max := 90.0
## Максимальный уклон flex (доля)
@export var flex_max_grade := 0.045
@export var flex_max_bends := 3   # XX claude-terra 13.1.7: третья ручка
## Длина одного сегмента коллизии flex, ю
@export var flex_collision_step := 20.0
## Не чаще одной пересборки меша/коллизий за этот период, с
@export var flex_rebuild_period := 0.05
## Радиус (по горизонтали от курсора), в котором конец flex цепляется к свободному сокету, ю
@export var flex_snap_radius := 8.0
## Масштаб касательных в изгибах. 0 = авто (лучший радиус из перебора 0.33-1.0).
## Больше (0.8-1.0) = изгиб растягивается по длине, меньше (0.33) = резче у ручки
@export var flex_bend_k := 0.0


# XX claude-wire W5: провода и подстолье (ATTN_23 §23.9)
@export_group("Wires")
## Радиус скругления изгиба провода, ю: на каком расстоянии от угла начинается дуга (короткий отрезок отдаёт углу не больше половины). 0 = острый угол
@export_range(0.0, 10.0, 0.1) var wire_bend_radius := 1.2
## Высота оси кабеля над поверхностью, на которой он лежит (стол, нижняя полка), ю. Кабель лежит на поверхности, а не висит над ней
@export_range(0.0, 2.0, 0.05) var wire_lift := 0.2
@export_group("Table")
## Глубина подрамника, ю: высота царг под плитой. Низ нижней полки на этой глубине под плитой. Не больше высоты ножек стола
@export_range(3.0, 30.0, 0.5) var apron_depth := 6.0

## Это не исп. а для справки
@export_group("Not Used")

@export var sleeper_size  = {
	'distance' : 0.4,
	'length' : 0.3,
	'width' : 3.0,
	'height' : 0.2,
	}


## Высота трака
func get_track_height() -> float:
	return track_head_segment.size.y + track_ballast_segment.size.y

	
