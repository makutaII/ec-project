class_name UnitTuning extends Resource

###################################
## Допуски узла тележки из модели (ModelRig): поперечный ход и поворот относительно кузова.
## Добавляется в WagonConfig.unit_tuning. Номер узла это число из роли unit_<n> в модели.
## Нужен длинному локо: опорный узел (ведущие оси) стоит посередине хорды между крайними тележками, на дуге она проходит
## внутри рельсов на s = (половина хорды)² / (2 · радиус): 0.33 м для хорды 10.6 м на радиусе 42 м.
###################################

## Номер узла: unit_<n> в модели
@export var unit: int = 1

## Поперечный ход узла относительно кузова, метры. 0: узел жёстко по оси кузова (как у обычных вагонов).
## Больше нуля: узел сдвигается поперёк к своей точке на рельсе, не дальше этого значения.
## Ориентир: допуск ≥ (половина хорды между крайними узлами)² / (2 · минимальный радиус пути); 0.45 м даёт радиус от 31 м для хорды 10.6 м
@export var lateral_play: float = 0.0

## Центровка узла из трёх и больше осей: 0 центр по хорде крайних осей (крайние колёса точно на рельсе, средние внутри дуги),
## 1 центр узла на рельсе (средние точно на рельсе, крайние снаружи), 0.5 делит ошибку поровну
@export_range(0.0, 1.0) var axle_balance: float = 0.5

## Предел поворота узла относительно кузова по курсу, градусы. 180: без ограничения.
## Жёсткая рама ведущих осей: порядка 3
@export var yaw_limit_deg: float = 180.0
