class_name PortalConfig extends ObjectConfig

# XX claude-terra 13.14 H7b2 (новый файл)
########################
## Паспорт объекта «Портал тоннеля» (C_TunnelPortal). Цепляется в C_Identity (object_config).
## Портал это визуальный декор: вагон по траку с U въезжает в гору и без него. Здесь габариты арки, глубины по умолчанию,
## точка установки и необязательная сцена с готовым визуалом.
########################

## Точка установки (начало координат объекта, пол арки по y): на лицевой плоскости или на тёмной плоскости
enum Anchor { FRONT, DARK }

## Ширина проёма, ю. 0 = по настройкам: ширина балласта плюс зазор выреза (terrain_cut_margin)
@export var width := 0.0
## Высота проёма над полом, ю. 0 = по настройкам: высота рельса плюс габарит (tunnel_clearance)
@export var height := 0.0
## Глубина арки по умолчанию, ю (в игре меняется в InfoPanel, 1-100)
@export var depth := 5
## Глубина тёмной плоскости от лицевой плоскости по умолчанию, ю (в игре меняется в InfoPanel, не больше глубины арки)
@export var dark_depth := 2.0
## По какой плоскости портал ставится. DARK: тёмная плоскость стоит в точке постановки, арка выступает наружу на dark_depth
@export var anchor: Anchor = Anchor.DARK
## Сцена с визуалом, если задана: берётся вместо процедурной арки. Корень Node3D в местной системе портала:
## пол на y = 0, центр проёма на x = 0, лицевая плоскость на z = 0, наружу +z (из горы), вглубь -z.
## Узел с именем Dark (если есть) считается тёмной плоскостью и ставится на её глубину, иначе тёмная плоскость строится кодом
@export var scene: PackedScene


## Типизированное чтение паспорта. null, если у сущности нет паспорта или в нём конфиг другого семейства
static func from_entity(entity: Entity) -> PortalConfig:
	var idc := entity.get_comp(C_Identity) as C_Identity
	if idc == null:
		return null
	return idc.object_config as PortalConfig
